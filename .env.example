# Prism MCP local Docker Compose configuration template
# Copy to .env and adjust as needed.

# ─── Application Service Ports ─────────────────────────────────────────────
# MCP Streamable HTTP endpoint (only used when PRISM_MCP_TRANSPORT=http)
PRISM_MCP_TRANSPORT=stdio
PRISM_MCP_HOST_PORT=3002
PRISM_MCP_PORT=3002
PRISM_MCP_PATH=/mcp

# Mind Palace dashboard HTTP server (read by src/config.ts / src/dashboard/server.ts)
PRISM_DASHBOARD_PORT=3001

# ─── Docker Compose: PostgreSQL (db service) ──────────────────────────────
# Host port exposed on localhost
PRISM_DB_HOST_PORT=5432
# Internal container port used by PostgreSQL and PostgREST connection URI
PRISM_DB_PORT=5432

# Database identity and credentials used by db + rest services
PRISM_DB_USER=prism
PRISM_DB_PASSWORD=prism_secret_change_me
PRISM_DB_NAME=prism_mcp

# ─── Docker Compose: PostgREST (rest service) ─────────────────────────────
# Host port exposed on localhost (used in SUPABASE_URL)
PRISM_REST_HOST_PORT=3000
# Internal container port PostgREST binds to
PRISM_REST_PORT=3000

PRISM_REST_DB_SCHEMAS=public
PRISM_REST_DB_ANON_ROLE=prism
PRISM_REST_JWT_SECRET=super-secret-jwt-token-for-local-dev-only-change-in-production

# ─── Docker Compose: Prism app (prism service) ────────────────────────────
# Internal PostgREST URL used by the Prism container.
# Keep this on the Compose network hostname unless you have a custom proxy.
PRISM_SUPABASE_URL=http://rest:3000
# Raw PostgREST in this Compose stack serves APIs at the root, not /rest/v1.
PRISM_SUPABASE_API_PREFIX=
# Optional override for the Prism container's bearer token.
# Leave unset to auto-generate a local service_role JWT from PRISM_REST_JWT_SECRET.
PRISM_SUPABASE_KEY=

# ─── Core Runtime API Keys ─────────────────────────────────────────────────
# Direct runtime keys passed through docker-compose to the Prism container.
GOOGLE_API_KEY=
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# ─── Web Search: Google Programmable Search ───────────────────────────────
# Single credential pair (used when PRISM_GOOGLE_SEARCH_CREDENTIALS is empty)
PRISM_GOOGLE_SEARCH_API_KEY=
PRISM_GOOGLE_SEARCH_CX=

# Multi-credential config.
# Plain JSON array uses ordered failover.
# Object form can set strategy to "failover" or "random".
# "random" still fails over across the remaining credentials after a random first pick.
# Alias field "channel" is also accepted instead of "cx".
# Examples:
# PRISM_GOOGLE_SEARCH_CREDENTIALS=[{"apiKey":"key-1","cx":"cx-1"},{"apiKey":"key-2","cx":"cx-2"}]
# PRISM_GOOGLE_SEARCH_CREDENTIALS={"strategy":"random","credentials":[{"apiKey":"key-1","cx":"cx-1"},{"apiKey":"key-2","cx":"cx-2"}]}
PRISM_GOOGLE_SEARCH_CREDENTIALS=

# ─── Brave Answers: Separate Brave Grounding Credential ───────────────────
# This is not used by brave_web_search and cannot be derived from
# PRISM_GOOGLE_SEARCH_CREDENTIALS.
PRISM_BRAVE_ANSWERS_API_KEY=

# ─── Optional Runtime Toggles For The Compose Stack ────────────────────────
# The local Compose path is PostgREST-backed by default, so PRISM_STORAGE is
# normally left unset here. Override only if you intentionally want a different
# storage mode inside the container.
# PRISM_ENABLE_HIVEMIND=true
PRISM_SCHEDULER_ENABLED=true
# PRISM_SCHEDULER_INTERVAL_MS=43200000
PRISM_SCHOLAR_ENABLED=false
# PRISM_SCHOLAR_INTERVAL_MS=300000
# PRISM_SCHOLAR_TOPICS=ai,agents
# PRISM_SCHOLAR_MAX_ARTICLES_PER_RUN=3
# PRISM_TASK_ROUTER_ENABLED=true
# PRISM_DISABLE_BRAVE_WEB_SEARCH_CODE_MODE=true
# PRISM_HDC_ENABLED=true
# PRISM_HDC_EXPLAINABILITY_ENABLED=true
# PRISM_ACTR_ENABLED=true
# PRISM_ACTR_DECAY=0.5
# PRISM_ACTR_WEIGHT_SIMILARITY=0.7
# PRISM_ACTR_WEIGHT_ACTIVATION=0.3
# PRISM_ACTR_ACCESS_LOG_RETENTION_DAYS=90
# PRISM_DARK_FACTORY_ENABLED=true
# PRISM_DARK_FACTORY_POLL_MS=30000
# PRISM_DARK_FACTORY_MAX_RUNTIME_MS=900000
# PRISM_AUTO_CAPTURE=true
# PRISM_CAPTURE_PORTS=3000,3001,5173,8080
# PRISM_DEBUG_LOGGING=true
